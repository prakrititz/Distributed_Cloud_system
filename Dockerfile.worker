# The WORKER image: nodes/ + helpers/ + config.py.
# The SAME image is started as many times as docker-compose.yml says
# (WORKERS in .env). Every copy finds its own id (worker1, worker2, ...) from
# the number Docker gives its container, and registers with the controller.
#
# Build from the project's top folder (docker compose does this for you):
#     docker build -f Dockerfile.worker -t object-store-worker .
#
# Which files go in is decided by Dockerfile.worker.dockerignore.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first (layer caching). requests is used to send the heartbeats.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The code. Started with `python -m nodes.node_server` from /app, because it
# imports "helpers" and "nodes" as packages.
COPY . .

# Settings. node_server.py reads all of these from the environment:
#   NODE_ID             "auto": container object-store-worker-2 becomes worker2
#                       (set a fixed id instead to run a single container by hand)
#   HOST                0.0.0.0, otherwise other containers cannot reach it
#   PORT                the port it listens on
#   CAPACITY            bytes it may store (default: 5 MB; compose sets it)
#   DATA_DIR            where the chunks live: its own folder in the volume
#                       below ({node_id} is replaced by the id, e.g. /data/worker2)
#   CONTROLLER_URL      where it registers and sends heartbeats
#   HEARTBEAT_INTERVAL  seconds between heartbeats
ENV HOST=0.0.0.0 \
    PORT=5000 \
    NODE_ID=auto \
    DATA_DIR=/data/{node_id} \
    CONTROLLER_URL=http://controller:5000

# Non-root user, and a /data folder it owns BEFORE it is declared a volume, so a
# new volume starts out owned by that user (and the worker can write to it).
RUN useradd --create-home --uid 10001 app \
    && mkdir /data \
    && chown app:app /data
USER app

# PERSISTENT STORAGE (required by the spec): the chunks live in /data, so they
# survive `docker stop` / `docker start`, re-creating the container and
# rebuilding the image. docker-compose.yml mounts one named volume here for all
# workers; each worker only uses its own folder in it (/data/worker1, ...).
VOLUME ["/data"]

EXPOSE 5000

# Healthy when the node answers its own health endpoint.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/internal/health' % os.environ.get('PORT', '5000'), timeout=2)"

CMD ["python", "-m", "nodes.node_server"]
